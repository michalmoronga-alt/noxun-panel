    { "case": "4 kridla, jedno stredne legacy", "wings_n": 4, "slots": [{ "wing": "p3", "state": "unset" }], "expect": ["left", null, "unknown", "right"] },
    { "case": "ziadne kridlo = ziadny symbol", "wings_n": 0, "slots": [], "expect": [] }
