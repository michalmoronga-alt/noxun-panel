    { "case": "1 kridlo, vedome NEURCENE -> otaznik (nie strana)", "wings_n": 1, "slots": [{ "wing": "single", "state": "unset" }], "expect": ["unknown"] },
    { "case": "1 kridlo LEGACY (kluc chyba) -> NIC", "wings_n": 1, "slots": [{ "wing": "single", "state": null }], "expect": [null] },
    { "case": "1 kridlo bez slotu -> strana sa NEHADA", "wings_n": 1, "slots": [], "expect": [null] },
    { "case": "2 kridla su ODVODENE (geometricky iste)", "wings_n": 2, "slots": [], "expect": ["left", "right"] },
    { "case": "3 kridla: krajne odvodene, stredne podla slotu", "wings_n": 3, "slots": [{ "wing": "p2", "state": "unset" }], "expect": ["left", "unknown", "right"] },
    { "case": "3 kridla bez slotu: stredne sa NEKRESLI, krajne ano", "wings_n": 3, "slots": [], "expect": ["left", null, "right"] },
    { "case": "3 kridla, stredne panty vpravo", "wings_n": 3, "slots": [{ "wing": "p2", "state": "right" }], "expect": ["left", "right", "right"] },
