"nav:ctrl": {"ctrlFilter":"red","tools":"<span class=\"echk\"><button type=\"button\" id=\"ecBtn\" class=\"ecbtn\" data-ec=\"toggle\" aria-pressed=\"false\" title=\"Farebné zvýraznenie stavu olepu priamo v modeli. Model sa nemení — kreslí sa nad ním.\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-eye\"/></svg>Zvýrazniť hrany</button><button type=\"button\" id=\"ecMore\" class=\"cornerzone\" data-ec=\"menu\" aria-expanded=\"false\" aria-haspopup=\"true\" aria-label=\"Nastavenie zvýraznenia hrán\" title=\"Nastavenie — ktoré stavy hrán sa zvýraznia\"></button><div class=\"ecmenu ecmenu-studio\" id=\"ecMenu\" role=\"group\" aria-label=\"Nastavenie ABS kontroly — ktoré stavy hrán sa zvýraznia\"><label class=\"ecopt\"><input type=\"checkbox\" onchange=\"edgeCheckOption('show_missing', this.checked)\"><i class=\"ecsw ecsw-missing\" aria-hidden=\"true\"></i><span>Chýba podľa pravidla</span><b class=\"eccnt\">0</b></label><label class=\"ecopt\"><input type=\"checkbox\" onchange=\"edgeCheckOption('show_extra', this.checked)\"><i class=\"ecsw ecsw-extra\" aria-hidden=\"true\"></i><span>Neolepené mimo pravidla</span><b class=\"eccnt\">0</b></label><label class=\"ecopt\"><input type=\"checkbox\" onchange=\"edgeCheckOption('show_taped', this.checked)\"><i class=\"ecsw ecsw-taped\" aria-hidden=\"true\"></i><span>Olepené</span><b class=\"eccnt\">0</b></label><label class=\"ecopt ecsub\"><input type=\"checkbox\" onchange=\"edgeCheckOption('taped_selected_only', this.checked)\"><span>len vybrané</span></label></div></span><span class=\"ecinfo\">Vypnuté — v modeli nie je nič nakreslené.</span><span class=\"spacer\"></span><span class=\"sechint\">Zoradené podľa závažnosti.</span><button type=\"button\" class=\"ghostbtn\" id=\"refreshBtn\" title=\"Prepočítať kontrolu z aktuálneho modelu\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-refresh-cw\"/></svg> Obnoviť</button>","body":"<div class=\"semafor\"><button type=\"button\" class=\"schip s-red on\" data-sev=\"red\" ti