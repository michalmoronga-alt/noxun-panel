"nav:bom": {"bomView":"sheets","bomQ":"X","groupClosed":{"M500":true},"cols":["name:true","cab:false","l:true","w:true","th:true","q:true","abs:true","grain:false","role:false"],"tools":"<div class=\"bomviews\"><button type=\"button\" class=\"bomvw\" data-view=\"parts\" title=\"Výrobné dielce po materiáloch\">Dielce</button><button type=\"button\" class=\"bomvw on\" data-view=\"sheets\" title=\"Súpis platní — odvodený z kusovníka\">Platne</button><button type=\"button\" class=\"bomvw\" data-view=\"abs\" title=\"Súpis ABS pások — odvodený z kusovníka\">ABS</button></div><label class=\"prjbox\" title=\"Názov zákazky — pomenuje priečinok a súbory VEPO exportu, titulok rozpočtu aj cenovej ponuky. Platí pre všetky exporty.\"><span class=\"prjlbl\">Projekt</span><input id=\"prjInput\" type=\"text\" value=\"GOLDEN\" placeholder=\"GOLDEN\"></label><div class=\"searchbox\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-search\"/></svg><input id=\"bomSearch\" placeholder=\"Hľadať…\" title=\"Hľadať dielec alebo skrinku\" aria-label=\"Hľadať dielec alebo skrinku\" value=\"X\"></div><span class=\"spacer\"></span><span class=\"vepofly\"><button type=\"button\" class=\"primary\" id=\"vepoBtn\" title=\"Exportuje prírezy (po odpočte ABS) do VEPO CSV — vyberieš priečinok\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-download\"/></svg> VEPO export</button><button type=\"button\" id=\"vepoMore\" class=\"cornerzone\" data-vepo=\"menu\" aria-expanded=\"false\" aria-haspopup=\"true\" aria-label=\"Nastavenie VEPO exportu\" title=\"Nastavenie exportu — čo sa spojí do jedného súboru\"></button><div class=\"vepomenu\" id=\"vepoMenu\" role=\"group\" aria-label=\"Nastavenie VEPO exportu\"><div class=\"mgrp\">Nastavenie VEPO exportu</div><label class=\"vopt\"><input type=\"checkbox\" id=\"mergeChk\" checked><span>18 + 36 spolu</span></label><div class=\"vnote\">Materiály 18 a 36 mm idú do jedného súboru (bežná objednávka).</div></div></span><button type=\"button\" class=\"ghostb